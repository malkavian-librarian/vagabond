# Copy this file to .env.local and fill in your keys
# Obtain OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Obtain Google Cloud keys at https://console.cloud.google.com/
# Required for Text-to-Speech
GOOGLE_TTS_API_KEY=your_google_tts_key_here
# Required for Imagen 3.0
GEMINI_API_KEY=your_gemini_key_here

# Optional: used for fallback images if Imagen is not configured
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
